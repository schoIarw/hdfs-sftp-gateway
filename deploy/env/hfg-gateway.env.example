# Gateway ID、服务组 ID、快照公钥和证书路径由 Manager 下载的
# /etc/hfg/hfg-gateway-bootstrap.env 提供，systemd 会自动加载该文件。
# 本文件只需填写两个现场值。

# 必填：Manager gRPC 地址；建议填写 Manager 证书 SAN 中的 DNS 名或 IP
HFG_RPC_HOST=hfg-manager.example.com
# 必填：本节点向 Manager 上报的 FTP/SFTP 服务 IP
HFG_NODE_IP=10.0.10.11
# 同一服务组的操作系统主机名必须唯一；Manager 会拒绝重复主机名心跳。
# /etc/krb5.conf 必须由宿主机提供，放入 HDFS ZIP 不会生效。

# 仅在非默认端口时配置
# HFG_FTP_PORT=21
# HFG_SFTP_PORT=22
# HFG_FTP_PASSIVE_PORTS=30000-31000

# 默认按单节点约 100 人并发传输配置；超过上限的传输最多等待 10 秒后快速失败。
# HFG_MAX_ACTIVE_TRANSFERS=120
# HFG_MAX_UPLOADS=80
# HFG_MAX_DOWNLOADS=80
# HFG_TRANSFER_ACQUIRE_TIMEOUT=PT10S
# HFG_FTP_MAX_LOGINS=200
# HFG_FTP_WORKER_THREADS=128
# HFG_SFTP_MAX_SESSIONS=200
# HFG_SFTP_MAX_CHANNELS=200
# HFG_SFTP_MAX_CHANNELS_PER_SESSION=4
# HFG_SFTP_WORKER_THREADS=128
# HFG_SFTP_IDLE_TIMEOUT=300

# 高级覆盖项通常无需配置：RPC_SERVER_NAME 默认等于 RPC_HOST；其余均使用固定路径/端口
# HFG_RPC_SERVER_NAME=hfg-manager.example.com
# HFG_RPC_PORT=19090
# HFG_RPC_CA=/etc/hfg/pki/ca.crt
# HFG_RPC_CLIENT_CERT=/etc/hfg/pki/gateway.crt
# HFG_RPC_CLIENT_KEY=/etc/hfg/pki/gateway.key
# 启用 SFTP 时默认路径必须已有可读密钥；同一 VIP 服务组的节点必须安全共享同一份
# HFG_SFTP_HOST_KEY=/etc/hfg/ssh_host_ed25519_key
# 中央 Prometheus 远程抓取时设为管理网 IP 或 0.0.0.0，并限制防火墙来源
# HFG_MANAGEMENT_BIND=127.0.0.1
# HFG_MANAGEMENT_PORT=18080
# HFG_HDFS_RUNTIME_PATH=/var/lib/hfg/hdfs-runtime
# HFG_HDFS_REFRESH_INTERVAL=PT1M
