HFG_DB_URL=jdbc:postgresql://postgres.example.com:5432/hfg
HFG_DB_USERNAME=hfg
HFG_DB_PASSWORD=CHANGE_ME
# PostgreSQL 使用默认迁移配置；MySQL 必须启用以下两项
# HFG_DB_MIGRATION_LOCATION=classpath:db/mysql
# HFG_UUID_JDBC_TYPE=CHAR

# 不配置即复用管理库；独立业务日志库才启用以下三项
# HFG_LOGS_DB_URL=jdbc:postgresql://logs.example.com:5432/hfg_logs
# HFG_LOGS_DB_USERNAME=hfg
# HFG_LOGS_DB_PASSWORD=CHANGE_ME
HFG_ADMIN_PASSWORD=CHANGE_ME
# 证书、CA 和快照签名密钥由 hfg-bootstrap.jar 写入
# /etc/hfg/hfg-manager-bootstrap.env，systemd 会自动加载该文件。
# 双 Manager 必须分发同一套 bootstrap/PKI，并共享 HFG_HDFS_BUNDLE_PATH。
# Kerberos HDFS 环境还必须由宿主机提供可用的 /etc/krb5.conf。

# 以下均有默认值，仅在现场需要覆盖时启用
# HFG_MANAGER_PORT=8080
# HFG_ADMIN_USERNAME=admin
# HFG_RPC_PORT=19090
# HFG_GATEWAY_CERT_VALIDITY_DAYS=365
# HFG_HDFS_BUNDLE_PATH=/var/lib/hfg/hdfs-bundles
# HFG_DB_POOL_SIZE=20
# HFG_DB_MIN_IDLE=2
# HFG_LOGS_DB_POOL_SIZE=10
# HFG_LOGS_RETENTION_DAYS=180
# HFG_LOGS_PRECREATE_DAYS=7
# HFG_PROMETHEUS_URL=http://prometheus.example.com:9090
