[Unit]
Description=HFG FTP/SFTP Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hfg
Group=hfg
EnvironmentFile=/etc/hfg/hfg-gateway.env
EnvironmentFile=-/etc/hfg/hfg-gateway-bootstrap.env
WorkingDirectory=/opt/hfg
ExecStart=/opt/hfg/jdk-17/bin/java -XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -jar /opt/hfg/hfg-gateway.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
PrivateTmp=true
# NoNewPrivileges is intentionally omitted because CentOS 7 uses a file
# capability on this dedicated Java executable for ports below 1024.

[Install]
WantedBy=multi-user.target
