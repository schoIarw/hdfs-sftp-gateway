[Unit]
Description=HFG Manager API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hfg
Group=hfg
EnvironmentFile=/etc/hfg/hfg-manager.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -jar /opt/hfg/hfg-manager.jar
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hfg

[Install]
WantedBy=multi-user.target
