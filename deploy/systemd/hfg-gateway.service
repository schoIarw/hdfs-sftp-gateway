[Unit]
Description=HFG FTP/SFTP Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hfg
Group=hfg
EnvironmentFile=/etc/hfg/hfg-gateway.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -jar /opt/hfg/hfg-gateway.jar
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
TasksMax=infinity
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hfg

[Install]
WantedBy=multi-user.target
