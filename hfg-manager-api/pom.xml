<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion><parent><groupId>io.github.scholiarw.hfg</groupId><artifactId>hfg-parent</artifactId><version>0.1.12</version></parent>
  <artifactId>hfg-manager-api</artifactId><name>HFG :: Manager API</name>
  <dependencies>
    <dependency><groupId>io.github.scholiarw.hfg</groupId><artifactId>hfg-manager-infrastructure</artifactId></dependency>
    <dependency><groupId>io.github.scholiarw.hfg</groupId><artifactId>hfg-storage-hdfs</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.scholiarw.hfg</groupId><artifactId>hfg-traffic-control</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
